        "name": "search_site",
        "title": "Search site",
        "description": "Case-insensitive keyword search across Highlander's site URLs (pulled from sitemap.xml). Returns matching page URLs. Useful for finding blog posts, service pages, and town pages by topic.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Keyword or phrase to match against page URLs, e.g. 'metal roofing highlands'."
            },
            "limit": {
              "description": "Max results to return (default 15).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "fetch_page",
        "title": "Fetch page",
        "description": "Fetch the raw HTML of a page on the Highlander site. Only URLs on highlandernc.com are allowed. Use search_site first to find URLs.",
