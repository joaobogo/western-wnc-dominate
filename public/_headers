# Sitewide security headers. Applied by Lovable/Netlify-style hosting.
# CSP is intentionally omitted — the site depends on GTM, Google Ads, Meta Pixel,
# TikTok Pixel, LinkedIn Insight, RealWork Labs, JobTread, chatbot edge functions,
# Google Fonts, and the Supabase project, and a hand-maintained allowlist would
# be a constant source of breakage. Revisit with a report-only CSP first.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), interest-cohort=(), browsing-topics=()
  X-Frame-Options: SAMEORIGIN

# Long-cache hashed Vite build assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Deployment fingerprint — must never be cached, the drift monitor reads it live
/build-info.json
  Cache-Control: no-store, max-age=0
  Content-Type: application/json
